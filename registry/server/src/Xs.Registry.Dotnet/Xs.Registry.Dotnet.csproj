<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xs.Registry.Dotnet</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS registry .NET project. Handles interaction with NuGet.</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Xs.Registry.Abstract/Xs.Registry.Abstract.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NuGet.Packaging" Version="4.9.3" />
    </ItemGroup>
</Project>