<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xs.Registry.Db</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS registry DB project. Encapsulates all DB-related logic. Internally separate per-project contexts.</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Diagnostics.Debug" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Configuration" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.DependencyInjection" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Mapper" Version="0.1.0" />
        <PackageReference Include="linq2db.EntityFrameworkCore" Version="1.5.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="2.2.1" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="2.2.0" />
        <PackageReference Include="NodaTime" Version="2.4.4" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="2.2.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="2.2.0" />
    </ItemGroup>
</Project>