<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xs.Registry.Abstract</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS registry abstract server project. Contains all stuff, shared between project servers. Is not intended to be used in main server.</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>library</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Xs.Registry.Db/Xs.Registry.Db.csproj" />
        <ProjectReference Include="../Xs.Registry.Shared/Xs.Registry.Shared.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Extensions.Execution" Version="0.1.0" />
    </ItemGroup>
</Project>