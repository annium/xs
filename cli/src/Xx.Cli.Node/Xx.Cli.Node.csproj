<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xx.Cli.Node</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Xx cli Node.JS project. All staff for Node.JS related things: project parsing, building, publishing, etc.</Description>
        <Solutions>Xx</Solutions>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Xx.Cli.Core/Xx.Cli.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Templates/**" />
        <EmbeddedResource Remove="Templates/.*" />
    </ItemGroup>
</Project>