<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xs.Cli.Core</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS cli core project. Provides access to base models, tools, projects, etc.</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Data.Models" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Arguments" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Configuration" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.DependencyInjection" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Net.Http" Version="0.1.0" />
        <PackageReference Include="NodaTime" Version="2.4.5" />
        <PackageReference Include="Scriban" Version="2.0.0" />
    </ItemGroup>
</Project>