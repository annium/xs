<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xs.Cli.Core</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS cli core project. Provides access to base models, tools, projects, etc.</Description>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Configuration.CommandLine" Version="0.1.0" />
        <PackageReference Include="Annium.Configuration.Yaml" Version="0.1.0" />
        <PackageReference Include="Annium.Data.Operations.Serialization.Json" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Arguments" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.CommandLine" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Shell" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Console" Version="0.1.0" />
        <PackageReference Include="Annium.Net.Http" Version="0.1.0" />
        <PackageReference Include="Annium.NodaTime.Serialization.Json" Version="0.1.0" />
        <PackageReference Include="Annium.Serialization.Json" Version="0.1.0" />
        <PackageReference Include="Annium.Serialization.Yaml" Version="0.1.0" />
        <PackageReference Include="Scriban" Version="5.9.1" />
    </ItemGroup>
</Project>