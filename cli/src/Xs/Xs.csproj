<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xs</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS cli main project. Entrypoint, contains all commands and tasks. Uses registry client and type-related projects for work.</Description>
        <TargetFramework>net7.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>11.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>xs</ToolCommandName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Xs.Cli.Dotnet/Xs.Cli.Dotnet.csproj" />
        <ProjectReference Include="../Xs.Cli.Node/Xs.Cli.Node.csproj" />
        <ProjectReference Include="../../../registry/client/src/Xs.RegistryClient.Main/Xs.RegistryClient.Main.csproj" />
        <ProjectReference Include="../../../registry/client/src/Xs.RegistryClient.Server/Xs.RegistryClient.Server.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.CommandLine" Version="0.1.0" />
        <PackageReference Include="EmbedIO" Version="3.5.0" />
        <PackageReference Include="LibGit2Sharp" Version="0.27.0-preview-0182" />
        <PackageReference Include="QuikGraph.Graphviz" Version="2.5.0" />
        <PackageReference Include="Unosquare.Swan.Lite" Version="3.1.0" />
    </ItemGroup>
</Project>