<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Server.Dotnet</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XS registry .NET project. Handles interaction with NuGet.</Description>
        <TargetFramework>net7.0</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>11.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Server.Abstractions/Server.Abstractions.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NuGet.Packaging" Version="6.7.0" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Scripts/**/*.sql" />
    </ItemGroup>
</Project>